{
  "name": "icon-pc-control",
  "productName": "ICON",
  "version": "0.2.4",
  "description": "Centre de contrôle et diagnostic local pour Windows, macOS et Linux.",
  "main": "main.js",
  "author": "ICON",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --dir --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:win:portable": "electron-builder --win portable --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "release:win": "electron-builder --win nsis portable --publish always",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.icon.desktop",
    "productName": "ICON",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ICON-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ICON",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "ICON-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "ICON-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "samybecker73-ops",
        "repo": "ICON",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "ICON.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samybecker73-ops/ICON.git"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "engines": {
    "node": ">=20"
  }
}
